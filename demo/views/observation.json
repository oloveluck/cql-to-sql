{
  "resourceType": "ViewDefinition",
  "name": "observation",
  "status": "active",
  "resource": "Observation",
  "select": [
    {
      "column": [
        { "name": "id", "path": "getResourceKey()", "type": "id" },
        { "name": "patient_id", "path": "subject.getReferenceKey(Patient)", "type": "string" },
        { "name": "status", "path": "status", "type": "code" },
        { "name": "effective", "path": "effective.ofType(dateTime)", "type": "dateTime" }
      ]
    },
    {
      "forEach": "code.coding",
      "column": [
        { "name": "code_system", "path": "system", "type": "uri" },
        { "name": "code", "path": "code", "type": "code" }
      ]
    }
  ]
}
