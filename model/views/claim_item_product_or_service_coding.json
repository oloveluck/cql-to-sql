{
  "name": "claim_item_product_or_service_coding",
  "resource": "Claim",
  "resourceType": "ViewDefinition",
  "select": [
    {
      "column": [
        {
          "name": "claim_id",
          "path": "getResourceKey()",
          "type": "id"
        },
        {
          "name": "patient_id",
          "path": "subject.getReferenceKey(Patient)",
          "type": "string"
        }
      ]
    },
    {
      "column": [
        {
          "name": "item_idx",
          "path": "%rowIndex",
          "type": "integer"
        }
      ],
      "forEach": "item",
      "select": [
        {
          "column": [
            {
              "name": "product_or_service_idx",
              "path": "%rowIndex",
              "type": "integer"
            },
            {
              "name": "system",
              "path": "system",
              "type": "string"
            },
            {
              "name": "code",
              "path": "code",
              "type": "code"
            },
            {
              "name": "display",
              "path": "display",
              "type": "string"
            }
          ],
          "forEach": "productOrService.coding"
        }
      ]
    }
  ],
  "status": "active"
}
