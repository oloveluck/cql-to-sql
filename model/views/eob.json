{
  "name": "eob",
  "resource": "ExplanationOfBenefit",
  "resourceType": "ViewDefinition",
  "select": [
    {
      "column": [
        {
          "name": "eob_id",
          "path": "getResourceKey()",
          "type": "id"
        },
        {
          "name": "patient_id",
          "path": "subject.getReferenceKey(Patient)",
          "type": "string"
        },
        {
          "name": "data_source",
          "path": "meta.tag.where(system = 'https://ncqa.org/fhir/CodeSystem/hedis-data-source').code.first()",
          "type": "code"
        },
        {
          "name": "status",
          "path": "status",
          "type": "code"
        },
        {
          "name": "use",
          "path": "use",
          "type": "code"
        },
        {
          "name": "outcome",
          "path": "outcome",
          "type": "code"
        },
        {
          "name": "billable_period_start",
          "path": "billablePeriod.start",
          "type": "dateTime"
        },
        {
          "name": "billable_period_end",
          "path": "billablePeriod.end",
          "type": "dateTime"
        }
      ]
    }
  ],
  "status": "active"
}
