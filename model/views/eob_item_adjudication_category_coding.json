{
  "name": "eob_item_adjudication_category_coding",
  "resource": "ExplanationOfBenefit",
  "resourceType": "ViewDefinition",
  "select": [
    {
      "column": [
        {
          "name": "eob_id",
          "path": "getResourceKey()",
          "type": "id"
        },
        {
          "name": "patient_id",
          "path": "subject.getReferenceKey(Patient)",
          "type": "string"
        }
      ]
    },
    {
      "column": [
        {
          "name": "item_idx",
          "path": "%rowIndex",
          "type": "integer"
        }
      ],
      "forEach": "item",
      "select": [
        {
          "column": [
            {
              "name": "adjudication_idx",
              "path": "%rowIndex",
              "type": "integer"
            }
          ],
          "forEach": "adjudication",
          "select": [
            {
              "column": [
                {
                  "name": "category_idx",
                  "path": "%rowIndex",
                  "type": "integer"
                },
                {
                  "name": "system",
                  "path": "system",
                  "type": "string"
                },
                {
                  "name": "code",
                  "path": "code",
                  "type": "code"
                },
                {
                  "name": "display",
                  "path": "display",
                  "type": "string"
                }
              ],
              "forEach": "category.coding"
            }
          ]
        }
      ]
    }
  ],
  "status": "active"
}
