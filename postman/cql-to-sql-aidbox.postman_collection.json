          "name": "4.3 Evaluate Measure (Individual Patient)",
          "request": {
            "method": "GET",
            "url": {
              "host": [
                "{{aidbox_url}}"
              ],
              "path": [
                "fhir",
                "Measure",
                "BreastScreeningDemo",
                "$evaluate-measure"
