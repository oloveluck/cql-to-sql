        {
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Returns valid FHIR MeasureReport', function () {",
                  "    var jsonData = pm.response.json();",
                  "    var report = jsonData[0].measure_report || jsonData[0];",
                  "    pm.expect(report.resourceType).to.eql('MeasureReport');",
                  "    pm.expect(report.type).to.eql('summary');",
                  "    pm.expect(report.group[0].population.length).to.eql(3);",
                  "});",
                  "",
                  "var jsonData = pm.response.json();",
                  "var r = jsonData[0].measure_report || jsonData[0];",
                  "var g = r.group[0];",
                  "var ip = g.population.find(p => p.code.coding[0].code === 'initial-population').count;",
                  "var denom = g.population.find(p => p.code.coding[0].code === 'denominator').count;",
                  "var num = g.population.find(p => p.code.coding[0].code === 'numerator').count;",
                  "var rate = (denom > 0 ? ((num / denom) * 100).toFixed(1) : '0.0');",
                  "",
                  "var template = `",
                  "<style>",
                  "  body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; padding: 24px; background: #f8fafc; color: #1e293b; }",
                  "  .card { background: white; border-radius: 12px; padding: 24px; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1); margin-bottom: 24px; max-width: 800px; }",
                  "  .header { display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #e2e8f0; padding-bottom: 16px; margin-bottom: 20px; }",
                  "  .title { font-size: 20px; font-weight: 700; color: #0f172a; margin: 0; }",
                  "  .sub { font-size: 13px; color: #64748b; margin-top: 4px; }",
                  "  .stats { display: flex; gap: 16px; margin-bottom: 20px; }",
                  "  .stat-box { flex: 1; padding: 16px; background: #f1f5f9; border-radius: 8px; text-align: center; }",
                  "  .stat-val { font-size: 32px; font-weight: 800; color: #0f172a; }",
                  "  .stat-lbl { font-size: 12px; font-weight: 600; color: #64748b; text-transform: uppercase; margin-top: 4px; }",
                  "  .stat-rate { color: #0284c7; }",
                  "  .badge { background: #dbeafe; color: #1e40af; padding: 4px 10px; border-radius: 12px; font-size: 12px; font-weight: 600; }",
                  "</style>",
                  "<div class=\"card\">",
                  "  <div class=\"header\">",
                  "    <div>",
                  "      <h2 class=\"title\">Breast Cancer Screening (BCS-E)</h2>",
                  "      <div class=\"sub\">Period: {{r.period.start}} &ndash; {{r.period.end}} | Resource: <strong>{{r.resourceType}}</strong></div>",
                  "    </div>",
                  "    <span class=\"badge\">{{r.status}}</span>",
                  "  </div>",
                  "  <div class=\"stats\">",
                  "    <div class=\"stat-box\"><div class=\"stat-val\">{{ip}}</div><div class=\"stat-lbl\">Initial Population</div></div>",
                  "    <div class=\"stat-box\"><div class=\"stat-val\">{{denom}}</div><div class=\"stat-lbl\">Denominator</div></div>",
                  "    <div class=\"stat-box\"><div class=\"stat-val\">{{num}}</div><div class=\"stat-lbl\">Numerator (Screened)</div></div>",
                  "    <div class=\"stat-box\"><div class=\"stat-val stat-rate\">{{rate}}%</div><div class=\"stat-lbl\">Screening Rate</div></div>",
                  "  </div>",
                  "</div>",
                  "`;",
                  "",
                  "pm.visualizer.set(template, { r: r, ip: ip, denom: denom, num: num, rate: rate });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "name": "3.4 Generate Summary MeasureReport directly from SQL",
          "request": {
            "body": {
              "mode": "raw",
              "options": {
                "raw": {
                  "language": "json"
                }
              },
              "raw": "[\"WITH params AS (SELECT TIMESTAMPTZ '2025-01-01T00:00:00.000Z' AS period_start, TIMESTAMPTZ '2025-12-31T23:59:59.999Z' AS period_end), mammography (system, code) AS (VALUES ('http://loinc.org', '24606-6'), ('http://snomed.info/sct', '71651007')), age_at_end_of_period AS (SELECT p.id AS patient_id, date_part('year', age((params.period_end AT TIME ZONE 'UTC')::date, p.birth_date::date))::int AS age FROM sof.patient p CROSS JOIN params), initial_population AS (SELECT p.id AS patient_id, COALESCE(p.gender = 'female' AND a.age BETWEEN 42 AND 74, false) AS v FROM sof.patient p JOIN age_at_end_of_period a ON a.patient_id = p.id), mammograms_during_period AS (SELECT DISTINCT replace(o.patient_id, 'Patient/', '') AS patient_id, o.id FROM sof.observation o JOIN mammography vs ON vs.system = o.code_system AND vs.code = o.code CROSS JOIN params WHERE o.status IN ('final', 'amended', 'corrected') AND o.effective::timestamptz BETWEEN params.period_start AND params.period_end), numerator AS (SELECT p.id AS patient_id, EXISTS (SELECT 1 FROM mammograms_during_period m WHERE m.patient_id = p.id) AS v FROM sof.patient p), cohort AS (SELECT ip.patient_id AS patient_id, ip.v::int AS ip, ip.v::int AS denom, (ip.v AND n.v)::int AS numer FROM initial_population ip JOIN numerator n ON n.patient_id = ip.patient_id), counts AS (SELECT SUM(ip) AS ip_count, SUM(denom) AS denom_count, SUM(numer) AS numer_count, ROUND(SUM(numer)::numeric / NULLIF(SUM(denom), 0), 3) AS score FROM cohort) SELECT jsonb_build_object('resourceType', 'MeasureReport', 'status', 'complete', 'type', 'summary', 'measure', 'http://example.org/fhir/Measure/BreastScreeningDemo', 'period', jsonb_build_object('start', '2025-01-01', 'end', '2025-12-31'), 'group', jsonb_build_array(jsonb_build_object('id', 'BreastScreening', 'population', jsonb_build_array(jsonb_build_object('code', jsonb_build_object('coding', jsonb_build_array(jsonb_build_object('system', 'http://terminology.hl7.org/CodeSystem/measure-population', 'code', 'initial-population'))), 'count', counts.ip_count), jsonb_build_object('code', jsonb_build_object('coding', jsonb_build_array(jsonb_build_object('system', 'http://terminology.hl7.org/CodeSystem/measure-population', 'code', 'denominator'))), 'count', counts.denom_count), jsonb_build_object('code', jsonb_build_object('coding', jsonb_build_array(jsonb_build_object('system', 'http://terminology.hl7.org/CodeSystem/measure-population', 'code', 'numerator'))), 'count', counts.numer_count)), 'measureScore', jsonb_build_object('value', counts.score)))) AS measure_report FROM counts;\"]"
            },
            "header": [
              {
                "key": "Content-Type",
                "type": "text",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "url": {
              "host": [
                "{{aidbox_url}}"
              ],
              "path": [
                "$sql"
              ],
              "query": [],
              "raw": "{{aidbox_url}}/$sql"
            }
          }
        },
        {
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Returns individual MeasureReport per patient', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.length).to.be.at.least(1);",
                  "    pm.expect(jsonData[0].measure_report.type).to.eql('individual');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "name": "3.5 Generate Individual MeasureReports for All Patients",
          "request": {
            "body": {
              "mode": "raw",
              "options": {
                "raw": {
                  "language": "json"
                }
              },
              "raw": "[\"WITH params AS (SELECT TIMESTAMPTZ '2025-01-01T00:00:00.000Z' AS period_start, TIMESTAMPTZ '2025-12-31T23:59:59.999Z' AS period_end), mammography (system, code) AS (VALUES ('http://loinc.org', '24606-6'), ('http://snomed.info/sct', '71651007')), age_at_end_of_period AS (SELECT p.id AS patient_id, date_part('year', age((params.period_end AT TIME ZONE 'UTC')::date, p.birth_date::date))::int AS age FROM sof.patient p CROSS JOIN params), initial_population AS (SELECT p.id AS patient_id, COALESCE(p.gender = 'female' AND a.age BETWEEN 42 AND 74, false) AS v FROM sof.patient p JOIN age_at_end_of_period a ON a.patient_id = p.id), mammograms_during_period AS (SELECT DISTINCT replace(o.patient_id, 'Patient/', '') AS patient_id, o.id FROM sof.observation o JOIN mammography vs ON vs.system = o.code_system AND vs.code = o.code CROSS JOIN params WHERE o.status IN ('final', 'amended', 'corrected') AND o.effective::timestamptz BETWEEN params.period_start AND params.period_end), numerator AS (SELECT p.id AS patient_id, EXISTS (SELECT 1 FROM mammograms_during_period m WHERE m.patient_id = p.id) AS v FROM sof.patient p), cohort AS (SELECT ip.patient_id AS patient_id, ip.v::int AS ip, ip.v::int AS denom, (ip.v AND n.v)::int AS numer FROM initial_population ip JOIN numerator n ON n.patient_id = ip.patient_id) SELECT jsonb_build_object('resourceType', 'MeasureReport', 'status', 'complete', 'type', 'individual', 'measure', 'http://example.org/fhir/Measure/BreastScreeningDemo', 'subject', jsonb_build_object('reference', 'Patient/' || c.patient_id), 'period', jsonb_build_object('start', '2025-01-01', 'end', '2025-12-31'), 'group', jsonb_build_array(jsonb_build_object('id', 'BreastScreening', 'population', jsonb_build_array(jsonb_build_object('code', jsonb_build_object('coding', jsonb_build_array(jsonb_build_object('system', 'http://terminology.hl7.org/CodeSystem/measure-population', 'code', 'initial-population'))), 'count', c.ip), jsonb_build_object('code', jsonb_build_object('coding', jsonb_build_array(jsonb_build_object('system', 'http://terminology.hl7.org/CodeSystem/measure-population', 'code', 'denominator'))), 'count', c.denom), jsonb_build_object('code', jsonb_build_object('coding', jsonb_build_array(jsonb_build_object('system', 'http://terminology.hl7.org/CodeSystem/measure-population', 'code', 'numerator'))), 'count', c.numer))))) AS measure_report FROM cohort c ORDER BY c.patient_id;\"]"
            },
            "header": [
              {
                "key": "Content-Type",
                "type": "text",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "url": {
              "host": [
                "{{aidbox_url}}"
              ],
              "path": [
                "$sql"
              ],
              "query": [],
              "raw": "{{aidbox_url}}/$sql"
            }
          }
        }
      ],
      "name": "3. Run SQL Queries ($sql)"
    },
    {
      "description": "Note: Standard Aidbox does not have a built-in $evaluate-measure CQL engine. Use Folder 3 (POST /$sql) for native Aidbox SQL-on-FHIR measure evaluation. This folder is for FHIR servers with a dedicated CQL engine plugin.",
      "item": [
        {
          "name": "4.1 Create Measure Resource",
          "request": {
            "body": {
              "mode": "raw",
              "options": {
                "raw": {
                  "language": "json"
                }
              },
              "raw": "{\"group\":[{\"id\":\"BreastScreening\",\"population\":[{\"code\":{\"coding\":[{\"code\":\"initial-population\",\"system\":\"http://terminology.hl7.org/CodeSystem/measure-population\"}]},\"criteria\":{\"expression\":\"Initial Population\",\"language\":\"text/cql-identifier\"}},{\"code\":{\"coding\":[{\"code\":\"denominator\",\"system\":\"http://terminology.hl7.org/CodeSystem/measure-population\"}]},\"criteria\":{\"expression\":\"Denominator\",\"language\":\"text/cql-identifier\"}},{\"code\":{\"coding\":[{\"code\":\"numerator\",\"system\":\"http://terminology.hl7.org/CodeSystem/measure-population\"}]},\"criteria\":{\"expression\":\"Numerator\",\"language\":\"text/cql-identifier\"}}]}],\"id\":\"BreastScreeningDemo\",\"library\":[\"http://example.org/fhir/Library/BreastScreeningDemo\"],\"name\":\"BreastScreeningDemo\",\"resourceType\":\"Measure\",\"scoring\":{\"coding\":[{\"code\":\"proportion\",\"system\":\"http://terminology.hl7.org/CodeSystem/measure-scoring\"}]},\"status\":\"draft\",\"title\":\"Breast Cancer Screening (demo)\",\"url\":\"http://example.org/fhir/Measure/BreastScreeningDemo\"}"
            },
            "header": [
              {
                "key": "Content-Type",
                "type": "text",
                "value": "application/json"
              }
            ],
            "method": "PUT",
            "url": {
              "host": [
                "{{aidbox_url}}"
              ],
              "path": [
                "fhir",
                "Measure",
                "BreastScreeningDemo"
              ],
              "query": [],
              "raw": "{{aidbox_url}}/fhir/Measure/BreastScreeningDemo"
            }
          }
        },
        {
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('MeasureReport is summary', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.resourceType).to.eql('MeasureReport');",
                  "    pm.expect(jsonData.type).to.eql('summary');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "name": "4.2 Evaluate Measure (Summary - Server Dependent)",
          "request": {
            "method": "GET",
            "url": {
              "host": [
                "{{aidbox_url}}"
              ],
              "path": [
                "fhir",
                "Measure",
                "BreastScreeningDemo",
                "$evaluate-measure"
              ],
              "query": [
                {
                  "key": "periodStart",
                  "value": "{{period_start}}"
                },
                {
                  "key": "periodEnd",
                  "value": "{{period_end}}"
                }
              ],
              "raw": "{{aidbox_url}}/fhir/Measure/BreastScreeningDemo/$evaluate-measure"
            }
          }
        },
        {
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('MeasureReport is individual', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.resourceType).to.eql('MeasureReport');",
                  "    pm.expect(jsonData.type).to.eql('individual');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "name": "4.3 Evaluate Measure (Individual - Server Dependent)",
          "request": {
            "method": "GET",
            "url": {
              "host": [
                "{{aidbox_url}}"
              ],
              "path": [
                "fhir",
                "Measure",
                "BreastScreeningDemo",
                "$evaluate-measure"
              ],
              "query": [
                {
                  "key": "subject",
                  "value": "Patient/p01-numerator"
                },
                {
                  "key": "periodStart",
                  "value": "{{period_start}}"
                },
                {
                  "key": "periodEnd",
                  "value": "{{period_end}}"
                }
              ],
              "raw": "{{aidbox_url}}/fhir/Measure/BreastScreeningDemo/$evaluate-measure"
            }
          }
        }
      ],
      "name": "4. FHIR Measure Evaluation (Optional / CQL Engine)"
    }
  ]
