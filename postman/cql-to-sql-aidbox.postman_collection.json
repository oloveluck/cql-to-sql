              "raw": "{\"entry\":[{\"request\":{\"method\":\"PUT\",\"url\":\"Patient/p01-numerator\"},\"resource\":{\"birthDate\":\"1970-05-01\",\"gender\":\"female\",\"id\":\"p01-numerator\",\"resourceType\":\"Patient\"}},{\"request\":{\"method\":\"PUT\",\"url\":\"Observation/p01-numerator-obs1\"},\"resource\":{\"code\":{\"coding\":[{\"code\":\"24606-6\",\"system\":\"http://loinc.org\"}]},\"effectiveDateTime\":\"2025-03-10T09:00:00Z\",\"id\":\"p01-numerator-obs1\",\"resourceType\":\"Observation\",\"status\":\"final\",\"subject\":{\"reference\":\"Patient/p01-numerator\"}}},{\"request\":{\"method\":\"PUT\",\"url\":\"Patient/p02-no-mammogram\"},\"resource\":{\"birthDate\":\"1965-08-20\",\"gender\":\"female\",\"id\":\"p02-no-mammogram\",\"resourceType\":\"Patient\"}},{\"request\":{\"method\":\"PUT\",\"url\":\"Patient/p03-too-young\"},\"resource\":{\"birthDate\":\"1990-02-14\",\"gender\":\"female\",\"id\":\"p03-too-young\",\"resourceType\":\"Patient\"}},{\"request\":{\"method\":\"PUT\",\"url\":\"Observation/p03-too-young-obs1\"},\"resource\":{\"code\":{\"coding\":[{\"code\":\"24606-6\",\"system\":\"http://loinc.org\"}]},\"effectiveDateTime\":\"2025-04-01T10:00:00Z\",\"id\":\"p03-too-young-obs1\",\"resourceType\":\"Observation\",\"status\":\"final\",\"subject\":{\"reference\":\"Patient/p03-too-young\"}}},{\"request\":{\"method\":\"PUT\",\"url\":\"Patient/p04-male\"},\"resource\":{\"birthDate\":\"1970-01-01\",\"gender\":\"male\",\"id\":\"p04-male\",\"resourceType\":\"Patient\"}},{\"request\":{\"method\":\"PUT\",\"url\":\"Observation/p04-male-obs1\"},\"resource\":{\"code\":{\"coding\":[{\"code\":\"24606-6\",\"system\":\"http://loinc.org\"}]},\"effectiveDateTime\":\"2025-04-01T10:00:00Z\",\"id\":\"p04-male-obs1\",\"resourceType\":\"Observation\",\"status\":\"final\",\"subject\":{\"reference\":\"Patient/p04-male\"}}},{\"request\":{\"method\":\"PUT\",\"url\":\"Patient/p05-mammogram-2023\"},\"resource\":{\"birthDate\":\"1960-07-07\",\"gender\":\"female\",\"id\":\"p05-mammogram-2023\",\"resourceType\":\"Patient\"}},{\"request\":{\"method\":\"PUT\",\"url\":\"Observation/p05-mammogram-2023-obs1\"},\"resource\":{\"code\":{\"coding\":[{\"code\":\"24606-6\",\"system\":\"http://loinc.org\"}]},\"effectiveDateTime\":\"2023-06-01T08:00:00Z\",\"id\":\"p05-mammogram-2023-obs1\",\"resourceType\":\"Observation\",\"status\":\"final\",\"subject\":{\"reference\":\"Patient/p05-mammogram-2023\"}}},{\"request\":{\"method\":\"PUT\",\"url\":\"Patient/p06-preliminary\"},\"resource\":{\"birthDate\":\"1975-04-04\",\"gender\":\"female\",\"id\":\"p06-preliminary\",\"resourceType\":\"Patient\"}},{\"request\":{\"method\":\"PUT\",\"url\":\"Observation/p06-preliminary-obs1\"},\"resource\":{\"code\":{\"coding\":[{\"code\":\"24606-6\",\"system\":\"http://loinc.org\"}]},\"effectiveDateTime\":\"2025-05-05T12:00:00Z\",\"id\":\"p06-preliminary-obs1\",\"resourceType\":\"Observation\",\"status\":\"preliminary\",\"subject\":{\"reference\":\"Patient/p06-preliminary\"}}},{\"request\":{\"method\":\"PUT\",\"url\":\"Patient/p07-other-code\"},\"resource\":{\"birthDate\":\"1972-09-09\",\"gender\":\"female\",\"id\":\"p07-other-code\",\"resourceType\":\"Patient\"}},{\"request\":{\"method\":\"PUT\",\"url\":\"Observation/p07-other-code-obs1\"},\"resource\":{\"code\":{\"coding\":[{\"code\":\"8302-2\",\"system\":\"http://loinc.org\"}]},\"effectiveDateTime\":\"2025-06-06T12:00:00Z\",\"id\":\"p07-other-code-obs1\",\"resourceType\":\"Observation\",\"status\":\"final\",\"subject\":{\"reference\":\"Patient/p07-other-code\"}}},{\"request\":{\"method\":\"PUT\",\"url\":\"Patient/p08-snomed-amended\"},\"resource\":{\"birthDate\":\"1958-12-01\",\"gender\":\"female\",\"id\":\"p08-snomed-amended\",\"resourceType\":\"Patient\"}},{\"request\":{\"method\":\"PUT\",\"url\":\"Observation/p08-snomed-amended-obs1\"},\"resource\":{\"code\":{\"coding\":[{\"code\":\"71651007\",\"system\":\"http://snomed.info/sct\"}]},\"effectiveDateTime\":\"2025-12-31T20:00:00Z\",\"id\":\"p08-snomed-amended-obs1\",\"resourceType\":\"Observation\",\"status\":\"amended\",\"subject\":{\"reference\":\"Patient/p08-snomed-amended\"}}},{\"request\":{\"method\":\"PUT\",\"url\":\"Patient/p09-age-74\"},\"resource\":{\"birthDate\":\"1951-12-31\",\"gender\":\"female\",\"id\":\"p09-age-74\",\"resourceType\":\"Patient\"}},{\"request\":{\"method\":\"PUT\",\"url\":\"Observation/p09-age-74-obs1\"},\"resource\":{\"code\":{\"coding\":[{\"code\":\"24606-6\",\"system\":\"http://loinc.org\"}]},\"effectiveDateTime\":\"2025-02-02T09:00:00Z\",\"id\":\"p09-age-74-obs1\",\"resourceType\":\"Observation\",\"status\":\"corrected\",\"subject\":{\"reference\":\"Patient/p09-age-74\"}}},{\"request\":{\"method\":\"PUT\",\"url\":\"Patient/p10-age-75\"},\"resource\":{\"birthDate\":\"1950-12-31\",\"gender\":\"female\",\"id\":\"p10-age-75\",\"resourceType\":\"Patient\"}},{\"request\":{\"method\":\"PUT\",\"url\":\"Observation/p10-age-75-obs1\"},\"resource\":{\"code\":{\"coding\":[{\"code\":\"24606-6\",\"system\":\"http://loinc.org\"}]},\"effectiveDateTime\":\"2025-02-02T09:00:00Z\",\"id\":\"p10-age-75-obs1\",\"resourceType\":\"Observation\",\"status\":\"final\",\"subject\":{\"reference\":\"Patient/p10-age-75\"}}},{\"request\":{\"method\":\"PUT\",\"url\":\"Patient/p11-age-42\"},\"resource\":{\"birthDate\":\"1983-12-31\",\"gender\":\"female\",\"id\":\"p11-age-42\",\"resourceType\":\"Patient\"}},{\"request\":{\"method\":\"PUT\",\"url\":\"Observation/p11-age-42-obs1\"},\"resource\":{\"code\":{\"coding\":[{\"code\":\"24606-6\",\"system\":\"http://loinc.org\"}]},\"effectiveDateTime\":\"2025-07-07T09:00:00Z\",\"id\":\"p11-age-42-obs1\",\"resourceType\":\"Observation\",\"status\":\"final\",\"subject\":{\"reference\":\"Patient/p11-age-42\"}}},{\"request\":{\"method\":\"PUT\",\"url\":\"Patient/p12-age-41\"},\"resource\":{\"birthDate\":\"1984-01-01\",\"gender\":\"female\",\"id\":\"p12-age-41\",\"resourceType\":\"Patient\"}},{\"request\":{\"method\":\"PUT\",\"url\":\"Observation/p12-age-41-obs1\"},\"resource\":{\"code\":{\"coding\":[{\"code\":\"24606-6\",\"system\":\"http://loinc.org\"}]},\"effectiveDateTime\":\"2025-07-07T09:00:00Z\",\"id\":\"p12-age-41-obs1\",\"resourceType\":\"Observation\",\"status\":\"final\",\"subject\":{\"reference\":\"Patient/p12-age-41\"}}},{\"request\":{\"method\":\"PUT\",\"url\":\"ViewDefinition/demo-patient\"},\"resource\":{\"id\":\"demo-patient\",\"name\":\"patient\",\"resource\":\"Patient\",\"resourceType\":\"ViewDefinition\",\"select\":[{\"column\":[{\"name\":\"id\",\"path\":\"getResourceKey()\",\"type\":\"id\"},{\"name\":\"gender\",\"path\":\"gender\",\"type\":\"code\"},{\"name\":\"birth_date\",\"path\":\"birthDate\",\"type\":\"date\"}]}],\"status\":\"active\"}},{\"request\":{\"method\":\"PUT\",\"url\":\"ViewDefinition/demo-observation\"},\"resource\":{\"id\":\"demo-observation\",\"name\":\"observation\",\"resource\":\"Observation\",\"resourceType\":\"ViewDefinition\",\"select\":[{\"column\":[{\"name\":\"id\",\"path\":\"getResourceKey()\",\"type\":\"id\"},{\"name\":\"patient_id\",\"path\":\"subject.getReferenceKey(Patient)\",\"type\":\"string\"},{\"name\":\"status\",\"path\":\"status\",\"type\":\"code\"},{\"name\":\"effective\",\"path\":\"effective.ofType(dateTime)\",\"type\":\"dateTime\"}]},{\"column\":[{\"name\":\"code_system\",\"path\":\"system\",\"type\":\"uri\"},{\"name\":\"code\",\"path\":\"code\",\"type\":\"code\"}],\"forEach\":\"code.coding\"}],\"status\":\"active\"}},{\"request\":{\"method\":\"POST\",\"url\":\"ViewDefinition/demo-patient/$materialize\"},\"resource\":{\"parameter\":[{\"name\":\"type\",\"valueCode\":\"view\"}],\"resourceType\":\"Parameters\"}},{\"request\":{\"method\":\"POST\",\"url\":\"ViewDefinition/demo-observation/$materialize\"},\"resource\":{\"parameter\":[{\"name\":\"type\",\"valueCode\":\"view\"}],\"resourceType\":\"Parameters\"}}],\"resourceType\":\"Bundle\",\"type\":\"transaction\"}"
            },
