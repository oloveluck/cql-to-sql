          "request": {
            "body": {
              "mode": "raw",
              "options": {
                "raw": {
                  "language": "json"
                }
              },
              "raw": "{\"group\":[{\"id\":\"BreastScreening\",\"population\":[{\"code\":{\"coding\":[{\"code\":\"initial-population\",\"system\":\"http://terminology.hl7.org/CodeSystem/measure-population\"}]},\"criteria\":{\"expression\":\"Initial Population\",\"language\":\"text/cql-identifier\"}},{\"code\":{\"coding\":[{\"code\":\"denominator\",\"system\":\"http://terminology.hl7.org/CodeSystem/measure-population\"}]},\"criteria\":{\"expression\":\"Denominator\",\"language\":\"text/cql-identifier\"}},{\"code\":{\"coding\":[{\"code\":\"numerator\",\"system\":\"http://terminology.hl7.org/CodeSystem/measure-population\"}]},\"criteria\":{\"expression\":\"Numerator\",\"language\":\"text/cql-identifier\"}}]}],\"id\":\"BreastScreeningDemo\",\"library\":[\"http://example.org/fhir/Library/BreastScreeningDemo\"],\"name\":\"BreastScreeningDemo\",\"resourceType\":\"Measure\",\"scoring\":{\"coding\":[{\"code\":\"proportion\",\"system\":\"http://terminology.hl7.org/CodeSystem/measure-scoring\"}]},\"status\":\"draft\",\"title\":\"Breast Cancer Screening (demo)\",\"url\":\"http://example.org/fhir/Measure/BreastScreeningDemo\"}"
            },
            "header": [
              {
                "key": "Content-Type",
                "type": "text",
                "value": "application/json"
              }
            ],
            "method": "PUT",
            "url": {
              "host": [
                "{{aidbox_url}}"
              ],
              "path": [
                "fhir",
                "Measure",
                "BreastScreeningDemo"
              ],
              "query": [],
              "raw": "{{aidbox_url}}/fhir/Measure/BreastScreeningDemo"
